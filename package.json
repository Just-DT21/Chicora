  "version": "1.0.0",
  "type": "module",
  "description": "CHICORA — a premium gift boutique with 10% advance booking",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
