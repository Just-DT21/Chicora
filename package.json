    "build": "vite build",
    "preview": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "db:check": "tsx server/scripts/check-supabase.ts",
    "db:setup": "tsx server/scripts/setup-supabase.ts",
    "db:verify": "tsx server/scripts/verify-supabase.ts",
    "db:workflows": "tsx server/scripts/test-supabase-workflows.ts",
    "db:migrate": "tsx server/scripts/migrate-to-supabase.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.1.1",
