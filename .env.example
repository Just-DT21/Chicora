# ---------------------------------------------------------------------------
# CHICORA configuration
# Copy this file to `.env` for local development, or set these variables in the
# hosting dashboard (Render -> Environment) for production. Every value below
# is a placeholder: never commit a real key, password or secret.
# ---------------------------------------------------------------------------

# HTTP port. Render sets this automatically; the server binds 0.0.0.0.
PORT=8787

# Admin dashboard ------------------------------------------------------------
# Prototype access code for /admin. Change it before going live.
ADMIN_ACCESS_CODE=chicora
# Signs the admin session cookie. Use 32+ random characters in production
# (`openssl rand -hex 32`). If omitted locally it is generated into data/.secret,
# which is git-ignored and NOT persistent on a hosting platform.
SESSION_SECRET=
# Only for plain-HTTP staging. Leave unset in production so cookies are Secure.
# INSECURE_COOKIES=1

# Store details shown on the site and in booking confirmations ---------------
STORE_PHONE="+91 98765 43210"
STORE_EMAIL="hello@chicora.in"
STORE_ADDRESS="14, Palm Court Lane, Indiranagar, Bengaluru 560038"
STORE_HOURS="Mon–Sat, 11:00–20:00 · Sun, 12:00–18:00"
STORE_INSTAGRAM="https://instagram.com/chicora"

# Booking policy -------------------------------------------------------------
# Fraction of the total paid online to reserve an item (0.10 = 10%).
ADVANCE_RATE=0.10
# How long an unverified UPI payment holds stock before it is released.
VERIFICATION_HOLD_MINUTES=60
# How many days a verified reservation is held in store for pickup.
PICKUP_HOLD_DAYS=7

# Payment details are managed by the admin in the dashboard (Admin -> Payment
# settings) and stored in Supabase, not in this file. No gateway keys needed.

# Supabase (production database + storage) -----------------------------------
# Set BOTH values to use PostgreSQL + Storage. Leave them blank and the shop
# falls back to the local store (data/store.json) for development.
#
#   npm run db:setup     apply all migrations (asks for the DB password once)
#   npm run db:verify    live checks of tables, functions, buckets and RLS
#   npm run db:migrate   copy local catalogue/QR/screenshots up (safe to re-run)
#
# The secret key bypasses row level security: it is SERVER-ONLY. Never put it in
# src/, index.html, a VITE_* variable, or anywhere the browser can read.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Older projects expose the same server key under this name (accepted as a fallback).
SUPABASE_SERVICE_ROLE_KEY=
# Public key — not used by this server; only needed if you add a browser SDK later.
SUPABASE_PUBLISHABLE_KEY=
